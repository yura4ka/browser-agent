{
  "name": "browswer-agent",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "start:proxy": "NODE_EXTRA_CA_CERTS=\"$HOME/.mitmproxy/mitmproxy-ca-cert.pem\" HTTPS_PROXY=http://127.0.0.1:8080 bun run index.ts",
    "bench:serve": "bun run benchmarks/server/serveBenchmark.ts",
    "bench:run": "bun run benchmarks/runner/runBenchmark.ts",
    "bench:aggregate": "bun run benchmarks/analysis/aggregateRuns.ts",
    "check": "bunx biome check .",
    "check:write": "bunx biome check --write .",
    "lint": "bun run check",
    "format": "bun run check:write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/bun": "^1.4.5"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "eventsource-parser": "^3.1.1",
    "jose": "^6.2.18",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  }
}
